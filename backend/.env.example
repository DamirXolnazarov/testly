# Copy to .env and fill in. Never commit the real .env.

# --- Supabase (required for everything) ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role secret>

# --- Auth ---
JWT_SECRET=<random long string>

# --- Google Sheets write-back (sheetsService.js) ---
GOOGLE_SERVICE_ACCOUNT_JSON=<base64 or raw JSON, per sheetsService.js>

# --- Media storage (storageService.js) — used by manual/zip exam-asset ---
# --- uploads AND AI-generated audio/images. Create this bucket as PUBLIC ---
# --- in the Supabase dashboard before uploads or generation will work.  ---
# SUPABASE_MEDIA_BUCKET=exam-media            # optional, this is the default
# UPLOAD_MAX_BYTES=26214400                   # optional, 25MB default (admin uploads only)

# --- AI exam generation (examGenerator.js) ---
# Text content (reading/listening scripts/writing prompts). Pick ONE provider:
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6          # optional override
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1                        # optional override

# Map question images + coordinate verification — ALWAYS OpenAI regardless
# of which LLM_PROVIDER you picked above for text content.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1              # optional override
# OPENAI_VISION_MODEL=gpt-4.1                 # optional override

# Listening audio (ttsService.js)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DEFAULT=
# ELEVENLABS_VOICE_ID_PART1=                  # optional, distinct voice per part
# ELEVENLABS_VOICE_ID_PART2=
# ELEVENLABS_VOICE_ID_PART3=
# ELEVENLABS_VOICE_ID_PART4=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2  # optional override
