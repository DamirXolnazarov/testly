# Copy to .env and fill in. Never commit the real .env.

# --- Supabase (required for everything) ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role secret>

# --- Auth ---
JWT_SECRET=<random long string>

# --- Google Sheets write-back (sheetsService.js) ---
GOOGLE_SERVICE_ACCOUNT_JSON=<base64 or raw JSON, per sheetsService.js>

# --- Media storage (storageService.js) — used by manual/zip exam-asset ---
# --- uploads AND AI-generated audio/images. Create this bucket as PUBLIC ---
# --- in the Supabase dashboard before uploads or generation will work.  ---
# SUPABASE_MEDIA_BUCKET=exam-media            # optional, this is the default
# UPLOAD_MAX_BYTES=26214400                   # optional, 25MB default (admin uploads only)

# --- AI Studio + AI exam generation (aiProvider.js) ---
# AI Studio (the chat that plans and builds exams) and the exam writer need
# at least one of these keys. With none set the studio shows a "not set up
# yet" notice and everything else in the app works as before.
#
# Claude — the best exam quality, paid. Used whenever this key is set.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5            # optional: the model that writes exam content
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5       # optional: the model behind the studio chat
#                                            #   (claude-sonnet-5-5 is the cheaper, faster swap)
#
# Free alternatives (openaiCompatClient.js). Any of these that are set are
# pooled: each request goes to the first model with allowance left. Free
# plans are small — Gemini allows each model about 20 requests a day, Groq
# about 200,000 tokens a day — so expect a couple of IELTS builds or one SAT
# build a day, and set both keys rather than one.
GEMINI_API_KEY=                              # https://aistudio.google.com/apikey
GROQ_API_KEY=                                # https://console.groq.com/keys
# AI_PROVIDER=compat                         # optional: stay on the free pool even with a Claude key set
# AI_WRITER_MODELS=gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b   # optional: exact models, in order
# AI_CHAT_MODELS=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b

# Map question images + coordinate verification — ALWAYS OpenAI regardless
# of which LLM_PROVIDER you picked above for text content. Optional: without
# it, AI-built reading papers simply don't include diagram-labelling tasks.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1              # optional override
# OPENAI_VISION_MODEL=gpt-4.1                 # optional override

# Listening audio (ttsService.js). With GEMINI_API_KEY set (above), audio is
# recorded by Gemini text-to-speech — two voices for conversations, and it
# works on the free tier — and nothing here is needed.
# ElevenLabs is the alternative: one voice per part, and its free plan only
# covers about two parts a month. It needs both the key and a default voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DEFAULT=
# ELEVENLABS_VOICE_ID_PART1=                  # optional, distinct voice per part
# ELEVENLABS_VOICE_ID_PART2=
# ELEVENLABS_VOICE_ID_PART3=
# ELEVENLABS_VOICE_ID_PART4=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2  # optional override
# TTS_PROVIDER=elevenlabs                     # optional: gemini | elevenlabs
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts   # optional override

# --- Admin access requests (routes/adminRequests.js, emailService.js) ---
# Sends email via Gmail SMTP — generate an App Password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# enabled on that Gmail account first). Not your normal Gmail password.
GMAIL_USER=<your Gmail address>
GMAIL_APP_PASSWORD=<16-character App Password>
ADMIN_NOTIFY_EMAIL=<where new access requests are emailed to, e.g. your own inbox>
# PUBLIC_BACKEND_URL=https://your-backend.onrender.com   # used to build the
#   approve/reject links in the notification email — falls back to
#   whatever host the request came in on if unset, so only needed if that
#   guess is ever wrong (e.g. behind a proxy)
# FRONTEND_URL=https://testly-mock.vercel.app             # used in the
#   credentials email's login link — defaults to the value shown here
